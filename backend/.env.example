# Ascend Fintech Platform - Environment Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite database path (for PostgreSQL in production, use postgresql://user:pass@host:5432/ascend)
DATABASE_URL="file:./dev.db"

# Cryptographic and Session Secrets
JWT_SECRET=ascend_jwt_production_secret_key_2026_replace_in_prod
OTP_SECRET=ascend_otp_secure_hmac_secret_2026_replace_in_prod
ENCRYPTION_KEY=ascend_bank_encryption_32_bytes_key!

# Nodemailer / SMTP Configuration (Leave empty to use console OTP logger in local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ascend" <no-reply@ascend-fintech.local>

# DigiLocker KYC Configuration
# Set to 'true' for simulated sandbox mock mode (default). Set to 'false' with real credentials in production.
DIGILOCKER_MOCK_MODE=true
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/kyc/digilocker/callback
